# ---------------------------------------------------------------------------
# Required before deploying
# ---------------------------------------------------------------------------
# Canonical origin. Drives canonicals, sitemap, OpenGraph URLs and JSON-LD —
# a wrong value silently breaks all four.
NEXT_PUBLIC_SITE_URL=https://hereandmore.com

# ---------------------------------------------------------------------------
# Access requests (/demo). With neither set, submissions are accepted and
# logged, and the form tells the person to email instead.
# ---------------------------------------------------------------------------
# Anything that accepts a JSON POST — Slack, Zapier, a CRM, your own API.
# ACCESS_WEBHOOK_URL=
# Or deliver by email via Resend:
# RESEND_API_KEY=
# ACCESS_TO_EMAIL=hello@hereandmore.com
# ACCESS_FROM_EMAIL=HERE & More <access@hereandmore.com>

# ---------------------------------------------------------------------------
# Entity signals. Only add profiles you actually control: a wrong sameAs is
# worse for entity resolution than no sameAs.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SAME_AS=https://www.linkedin.com/company/…,https://github.com/…
# NEXT_PUBLIC_TWITTER_HANDLE=@…

# ---------------------------------------------------------------------------
# Search console verification (omitted from the HTML when unset)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Sanity CMS. Unset = the site reads the typed content in /content.
# Set all three and it reads Sanity instead, with no template changes.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# SANITY_API_READ_TOKEN=
